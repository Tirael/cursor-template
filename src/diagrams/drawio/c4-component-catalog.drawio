<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="C4 Component - Catalog Service" id="c4cmp">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== RANK 0: Entry Point (y=20) ===== -->

        <mxCell id="cnt_gateway"
                value="&lt;b&gt;API Gateway / BFF&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: .NET 8]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Маршрутизация запросов"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=10;verticalAlign=middle;align=center;spacing=6;"
                vertex="1" parent="1">
          <mxGeometry x="510" y="20" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== COMPONENT BOUNDARY ===== -->

        <mxCell id="boundary_catalog"
                value="Catalog Service [Container: .NET 8]"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#438DD5;fontSize=14;fontStyle=3;fontColor=#438DD5;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacing=10;container=0;"
                vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="1240" height="460" as="geometry"/>
        </mxCell>

        <!-- ===== RANK 1: API Controller (y=190) ===== -->

        <mxCell id="cmp_controller"
                value="&lt;b&gt;CatalogApiController&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: REST Controller]&lt;/i&gt;&lt;br&gt;&lt;br&gt;REST API для каталога:&lt;br&gt;книги, авторы, жанры, цены"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;fontSize=11;arcSize=6;verticalAlign=middle;align=center;spacing=4;"
                vertex="1" parent="1">
          <mxGeometry x="510" y="190" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== RANK 2: Application Service (y=330) ===== -->

        <mxCell id="cmp_app_service"
                value="&lt;b&gt;CatalogApplicationService&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Application Service]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Бизнес-логика: CRUD книг,&lt;br&gt;управление ценами, публикация событий"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;fontSize=11;arcSize=6;verticalAlign=middle;align=center;spacing=4;"
                vertex="1" parent="1">
          <mxGeometry x="460" y="330" width="380" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== RANK 3: Infrastructure (y=480) ===== -->
        <!-- 4 components × 240w + 3 × 40 gap = 1080; startX = (1400-1080)/2 = 160 -->

        <mxCell id="cmp_book_repo"
                value="&lt;b&gt;BookRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Repository]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Доступ к данным&lt;br&gt;книг и авторов"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;fontSize=11;arcSize=6;verticalAlign=middle;align=center;spacing=4;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="480" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="cmp_price_repo"
                value="&lt;b&gt;PriceRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Repository]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Управление ценами&lt;br&gt;и скидками"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;fontSize=11;arcSize=6;verticalAlign=middle;align=center;spacing=4;"
                vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="cmp_cache"
                value="&lt;b&gt;CacheProvider&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Cache]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Cache-aside для&lt;br&gt;каталога (Redis)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;fontSize=11;arcSize=6;verticalAlign=middle;align=center;spacing=4;"
                vertex="1" parent="1">
          <mxGeometry x="680" y="480" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="cmp_outbox"
                value="&lt;b&gt;OutboxPublisher&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: Publisher]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Transactional Outbox&lt;br&gt;для Integration Events"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;fontSize=11;arcSize=6;verticalAlign=middle;align=center;spacing=4;"
                vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== RANK 4: Data Stores (y=700) ===== -->
        <!-- 3 stores: CatalogDB, Redis, Kafka -->
        <!-- Positioned under their connected infrastructure components -->

        <mxCell id="db_catalog"
                value="&lt;b&gt;Catalog DB&lt;/b&gt;&lt;br&gt;&lt;i&gt;[PostgreSQL]&lt;/i&gt;"
                style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;size=15;verticalAlign=middle;align=center;spacing=6;"
                vertex="1" parent="1">
          <mxGeometry x="260" y="700" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="db_redis"
                value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Cache]&lt;/i&gt;"
                style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;size=15;verticalAlign=middle;align=center;spacing=6;"
                vertex="1" parent="1">
          <mxGeometry x="590" y="700" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="db_kafka"
                value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Message Broker]&lt;/i&gt;"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=10;dashed=1;dashPattern=8 4;verticalAlign=middle;align=center;spacing=6;"
                vertex="1" parent="1">
          <mxGeometry x="920" y="700" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES: Entry → Controller ===== -->

        <mxCell id="e_gw_ctrl"
                value="Маршрутизация [gRPC / mTLS]"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cnt_gateway" target="cmp_controller" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES: Controller → Application Service ===== -->

        <mxCell id="e_ctrl_svc"
                value="Делегирует [in-process]"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_controller" target="cmp_app_service" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES: Application Service → Infrastructure (fan-out) ===== -->

        <mxCell id="e_svc_bookrepo"
                value="Читает / пишет книги"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_app_service" target="cmp_book_repo" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_svc_pricerepo"
                value="Читает / пишет цены"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_app_service" target="cmp_price_repo" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_svc_cache"
                value="Кэширует запросы"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_app_service" target="cmp_cache" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_svc_outbox"
                value="Публикует события"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_app_service" target="cmp_outbox" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== EDGES: Infrastructure → Data Stores ===== -->

        <mxCell id="e_bookrepo_db"
                value="SQL запросы"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_book_repo" target="db_catalog" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_pricerepo_db"
                value="SQL запросы"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_price_repo" target="db_catalog" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_cache_redis"
                value="GET / SET [Redis Protocol]"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;"
                edge="1" source="cmp_cache" target="db_redis" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_outbox_kafka"
                value="Отправка событий&lt;br&gt;[Kafka Producer]"
                style="html=1;fontSize=11;fontColor=#404040;strokeColor=#666666;strokeWidth=2;endArrow=blockThin;endFill=1;edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;dashed=1;dashPattern=8 4;"
                edge="1" source="cmp_outbox" target="db_kafka" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
